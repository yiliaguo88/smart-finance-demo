<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.finance.repository.VoucherMapper">

    <resultMap id="VoucherRM" type="com.example.finance.entity.Voucher">
        <id     property="id"          column="id"/>
        <result property="voucherNo"   column="voucher_no"/>
        <result property="companyId"   column="company_id"/>
        <result property="period"      column="period"/>
        <result property="voucherType" column="voucher_type"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status"      column="status"/>
        <result property="createdBy"   column="created_by"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO voucher (voucher_no, company_id, period, voucher_type,
                             total_amount, status, created_by, created_at)
        VALUES (#{voucherNo}, #{companyId}, #{period}, #{voucherType},
                #{totalAmount}, #{status}, #{createdBy}, #{createdAt})
    </insert>

    <select id="findByCompanyAndPeriod" resultMap="VoucherRM">
        SELECT * FROM voucher
        WHERE company_id = #{companyId} AND period = #{period}
        ORDER BY created_at DESC
    </select>

    <select id="findAll" resultMap="VoucherRM">
        SELECT * FROM voucher ORDER BY created_at DESC
    </select>

</mapper>
